# Copy to .env and adjust for your environment. Never commit the real .env.
# All variables are prefixed ACPDM_ and are optional — see src/settings.py
# for defaults.

ACPDM_ENV=development

# Required in any real deployment — the dev default is not secret.
ACPDM_API_KEY=change-me-in-production

# JSON array of allowed CORS origins, e.g. ["https://app.example.com"].
# Empty = no cross-origin requests allowed. Never use "*" in production.
ACPDM_CORS_ALLOW_ORIGINS=[]

ACPDM_LOG_LEVEL=INFO
ACPDM_LOG_JSON=true

# Leave unset to use MLflow's local ./mlruns store, or point at a tracking
# server, e.g. http://mlflow:5000 (matches docker-compose.yml's service name).
ACPDM_MLFLOW_TRACKING_URI=

ACPDM_MAX_READINGS_PER_REQUEST=500
ACPDM_MAX_BODY_SIZE_BYTES=1048576

ACPDM_MODEL_REGISTRY_ALIAS=production
ACPDM_MIN_HOLDOUT_F1_FOR_PROMOTION=0.0

ACPDM_HOST=0.0.0.0
ACPDM_PORT=8000

ACPDM_DATA_RAW_PATH=data/raw/aircompressor.csv
